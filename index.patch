+/* ---- Info persil/sertipikat pada popup rumah ibadah ---- */
+const persilCache = new Map();
+function nibProp(p){ const k = Object.keys(p||{}).find(k=>/nib/i.test(k)); return k && p[k]!=null ? String(p[k]).trim() : ''; }
+async function lookupPersil(d){
+  const key = d.lng.toFixed(6)+','+d.lat.toFixed(6)+'|'+overlays.map(o=>o.id).join(',');
+  if(persilCache.has(key)) return persilCache.get(key);
+  const hits = [];
+  const vec = overlays.filter(o=>o.kind==='vector');
+  if(vec.length && serverOK){
+    const names = Object.fromEntries(vec.map(o=>[o.id,o.name]));
+    const {data:rows, error} = await sb.rpc('persil_cek', {p_layers:vec.map(o=>o.id), p_pts:[{i:0, lng:d.lng, lat:d.lat}]});
+    if(error) throw error;
+    (rows||[]).forEach(r=>hits.push({layer:names[r.layer_id]||r.layer_id, nib:r.nib||'', tipe:r.tipe_hak||'', kel:r.kelurahan||'', kec:r.kecamatan||''}));
+  }
+  // layer GeoJSON biasa: hanya yang memiliki kolom NIB (layer batas desa/kecamatan dilewati)
+  overlays.filter(o=>o.kind!=='vector' && o.fc).forEach(o=>{
+    o.fc.features.forEach(f=>{
+      const g = f.geometry; if(!g || !/Polygon/.test(g.type) || !nibProp(f.properties)) return;
+      let bb; try{ bb = bboxOf(g.coordinates); }catch(e){ return; }
+      if(d.lng>=bb[0]&&d.lng<=bb[2]&&d.lat>=bb[1]&&d.lat<=bb[3]&&geomHas(g,d.lng,d.lat)){
+        const p = f.properties||{};
+        hits.push({layer:o.name, nib:nibProp(p), tipe:propVal(p,Object.keys(p).find(k=>/tipe_?hak|jenis_?hak/i.test(k))),
+                   kel:propVal(p,Object.keys(p).find(k=>RE_DESA.test(k))), kec:propVal(p,Object.keys(p).find(k=>RE_KEC.test(k)))});
+      }
+    });
+  });
+  persilCache.set(key, hits);
+  return hits;
+}
+async function fillPersilInfo(d, popup){
+  const el = popup && popup.getElement && popup.getElement();
+  const slot = el && el.querySelector('.persil-slot');
+  if(!slot) return;
+  const done = (cls, html)=>{ slot.className = 'persil-slot '+cls; slot.innerHTML = html; popupRefresh(el, popup); };
+  if(!overlays.length) return done('', '<small>Belum ada layer persil/sertipikat di peta.</small>');
+  try{
+    const hits = await lookupPersil(d);
+    if(!hits.length) return done('no', '<b>Belum Sertipikat</b><br><small>Titik tidak berada di dalam poligon persil.</small>');
+    done('ok', '<b>Sudah Sertipikat</b>' + hits.map(h=>`<table>
+      <tr><td><b>NIB</b></td><td>${esc(h.nib||'(kosong)')}</td></tr>
+      <tr><td><b>Tipe Hak</b></td><td>${esc(h.tipe||'-')}</td></tr>
+      <tr><td><b>Kelurahan/Desa</b></td><td>${esc(h.kel||'-')}</td></tr>
+      <tr><td><b>Kecamatan</b></td><td>${esc(h.kec||'-')}</td></tr></table>`).join(''));
+  }catch(e){ done('', '<small>Gagal memeriksa persil: '+esc(e.message||e)+'</small>'); }
 }
 
