+/* Daftar rumah ibadah yang berada di dalam persil yang diklik (dicocokkan lewat NIB dari persil_cek) */
+async function fillRumahDiPersil(o, p, ll, popup){
+  const el = popup.getElement && popup.getElement();
+  const slot = el && el.querySelector('.persil-slot');
+  if(!slot) return;
+  const done = (cls, html)=>{ slot.className='persil-slot '+cls; slot.innerHTML=html; popupRefresh(el, popup); };
+  try{
+    const nib = p.nib ? String(p.nib).trim() : '';
+    if(!nib) return done('', '<small>Persil ini tidak punya NIB sehingga tidak bisa dicocokkan dengan rumah ibadah.</small>');
+    const R = 0.004;                         // ±0,4 km dari titik klik
+    const near = data.filter(d=>Math.abs(d.lat-ll.lat)<=R && Math.abs(d.lng-ll.lng)<=R);
+    if(!near.length) return done('', '<small>Tidak ada rumah ibadah di dalam persil ini.</small>');
+    const {data:rows, error} = await sb.rpc('persil_cek', {p_layers:[o.id], p_pts:near.map((d,i)=>({i, lng:d.lng, lat:d.lat}))});
+    if(error) throw error;
+    const inside = (rows||[]).filter(r=>String(r.nib||'').trim()===nib && String(r.kelurahan||'')===String(p.kelurahan||'')).map(r=>near[r.i]).filter(Boolean);
+    const uniq = [...new Map(inside.map(d=>[d.id+'|'+d.nama, d])).values()];
+    if(!uniq.length) return done('', '<small>Tidak ada rumah ibadah di dalam persil ini.</small>');
+    done('ok', `<b>🕌 Rumah ibadah di persil ini (${uniq.length})</b><ul class="rbd">` +
+      uniq.map(d=>`<li>${(JENIS[d.jenis]||{icon:'📍'}).icon} <b>${esc(d.nama)}</b> <small>(${esc(d.jenis)})</small></li>`).join('') + '</ul>');
+  }catch(e){ done('', '<small>Gagal memeriksa rumah ibadah: '+esc(e.message||e)+'</small>'); }
+}
