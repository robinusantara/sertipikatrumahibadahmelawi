+/* Cache layer di IndexedDB terpisah: kunjungan berikutnya tidak perlu mengunduh ulang puluhan MB. */
+const CACHE_DB='melawi_layer_cache', CACHE_STORE='fc';
+function cacheDb(){
+  return new Promise((res,rej)=>{
+    const r = indexedDB.open(CACHE_DB,1);
+    r.onupgradeneeded = ()=>r.result.createObjectStore(CACHE_STORE,{keyPath:'id'});
+    r.onsuccess = ()=>res(r.result); r.onerror = ()=>rej(r.error);
+  });
+}
+async function cacheGet(id, ver){
+  try{
+    const db = await cacheDb();
+    return await new Promise(res=>{
+      const q = db.transaction(CACHE_STORE,'readonly').objectStore(CACHE_STORE).get(id);
+      q.onsuccess = ()=>res(q.result && q.result.ver===ver ? q.result.fc : null);
+      q.onerror = ()=>res(null);
+    });
+  }catch(e){ return null; }
+}
+async function cachePut(id, ver, fc){
+  try{
+    const db = await cacheDb();
+    db.transaction(CACHE_STORE,'readwrite').objectStore(CACHE_STORE).put({id, ver, fc});
+  }catch(e){}
+}
+function cacheDel(id){
+  cacheDb().then(db=>db.transaction(CACHE_STORE,'readwrite').objectStore(CACHE_STORE).delete(id)).catch(()=>{});
+}
+const layerVer = l => [l.count, l.chunks, l.created_at].join('|');
+
+/* Batasi permintaan serentak ke Supabase (ratusan permintaan sekaligus membuat server membalas 500/504). */
+const REQ_MAX = IS_MOBILE ? 2 : 3;
+let reqActive = 0; const reqQ = [];
+function limited(fn){
+  return new Promise((res,rej)=>{
+    const run = ()=>{
+      reqActive++;
+      Promise.resolve().then(fn).then(res,rej).finally(()=>{ reqActive--; const nx = reqQ.shift(); if(nx) nx(); });
+    };
+    reqActive < REQ_MAX ? run() : reqQ.push(run);
+  });
+}
+async function withRetry(fn, tries=4){
+  let last;
+  for(let i=0;i<tries;i++){
+    try{ return await fn(); }
+    catch(e){ last = e; if(e && e.fatal) throw e; await new Promise(r=>setTimeout(r, 700*Math.pow(2,i))); }
+  }
+  throw last;
+}
+const failedLayers = [];
