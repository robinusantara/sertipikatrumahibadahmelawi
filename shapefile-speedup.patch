+const SHP_URLS = ['https://unpkg.com/shpjs@4.0.4/dist/shp.min.js','https://cdn.jsdelivr.net/npm/shpjs@4.0.4/dist/shp.min.js'];
+function parseShpWorker(buf){
+  return new Promise((resolve,reject)=>{
+    let w, url;
+    try{
+      const src = `(function(){var u=${JSON.stringify(SHP_URLS)},ok=0;for(var i=0;i<u.length&&!ok;i++){try{importScripts(u[i]);ok=1;}catch(e){}}if(!ok)throw new Error('shpjs');})();
+        const rc=c=>typeof c[0]==='number'?[Math.round(c[0]*1e6)/1e6,Math.round(c[1]*1e6)/1e6]:c.map(rc);
+        self.onmessage=async e=>{
+          try{
+            let r = await shp(e.data); r = Array.isArray(r)?r:[r];
+            r.forEach(fc=>{
+              fc.features = (fc.features||[]).filter(f=>f&&f.geometry&&f.geometry.coordinates&&f.geometry.coordinates.length);
+              fc.features.forEach(f=>{f.geometry.coordinates=rc(f.geometry.coordinates);});
+            });
+            postMessage({ok:r});
+          }catch(err){ postMessage({err:String(err&&err.message||err)}); }
+        };`;
+      url = URL.createObjectURL(new Blob([src],{type:'text/javascript'}));
+      w = new Worker(url);
+    }catch(e){ return reject(e); }
+    const done = fn=>v=>{ w.terminate(); URL.revokeObjectURL(url); fn(v); };
+    w.onmessage = e=> e.data.err ? done(reject)(new Error(e.data.err)) : done(resolve)(e.data.ok);
+    w.onerror = e=> done(reject)(new Error('worker'));
+    w.postMessage(buf,[buf]);
+  });
+}
