+/* Ambil 4 atribut dari shapefile (nama kolom boleh bervariasi) */
+const PERSIL_RE = {
+  NIB:       /^(NO)?NIB$|^NIB/,
+  TIPEHAK:   /^(TIPEHAK|JENISHAK)/,
+  KELURAHAN: /^(KELURAHAN|KEL|NAMAKEL|NMKEL|DESA|NAMADESA|NMDESA|WADMKD|DESAKEL|KELDESA)$/,
+  KECAMATAN: /^(KECAMATAN|KEC|NAMAKEC|NMKEC|WADMKC)$/
+};
+function pickProp(p, re){
+  let best = null;
+  for(const k in p){
+    if(re.test(k.toUpperCase().replace(/[^A-Z0-9]/g,'')) && (best===null || k.length<best.length || (k.length===best.length && k<best))) best = k;
+  }
+  if(best===null) return undefined;
+  const v = p[best];
+  return (v==null || String(v).trim()==='') ? undefined : String(v).trim();
+}
+function isPersilFc(fc){
+  const sample = fc.features.slice(0,200);
+  const poly = sample.some(f=>f.geometry && /Polygon/.test(f.geometry.type));
+  const nib  = sample.some(f=>f.properties && Object.keys(f.properties).some(k=>/nib/i.test(k)));
+  return poly && nib;
+}
+
+async function uploadVectorLayer(name, fc, info){
+  const id = genId(), color = PALETTE[overlays.length % PALETTE.length];
+  const feats = fc.features.filter(f=>f && f.geometry && /Polygon/.test(f.geometry.type)).map(f=>{
+    const src = f.properties || {}, props = {};
+    for(const [k,re] of Object.entries(PERSIL_RE)){ const v = pickProp(src,re); if(v!==undefined) props[k] = v; }
+    return {geometry:f.geometry, properties:props};
+  });
+  if(!feats.length) throw new Error(`Tidak ada poligon di layer "${name}".`);
+
+  const batches = []; let cur = [], size = 0;
+  for(const f of feats){
+    const sz = JSON.stringify(f).length;
+    if(size+sz > 700000 && cur.length){ batches.push(cur); cur=[]; size=0; }
+    cur.push(f); size += sz;
+  }
+  if(cur.length) batches.push(cur);
+
+  uploadingLayer = true;
+  let rowCreated = false;
+  try{
+    const ins = await sb.from('layers').insert({id, name, color, chunks:0, count:0, kind:'vector'});
+    if(ins.error) throw ins.error;
+    rowCreated = true;
+    let done = 0, next = 0, failed = null;
+    const worker = async ()=>{
+      while(next < batches.length && !failed){
+        const n = next++;
+        try{
+          await withRetry(async ()=>{
+            const res = await sb.rpc('persil_import', {p_layer:id, p_features:batches[n]});
+            if(res.error) throw res.error;
+          });
+          info(`Mengunggah persil "${name}" (${++done}/${batches.length}) — jangan tutup halaman...`);
+        }catch(e){ failed = e; }
+      }
+    };
+    await Promise.all(Array.from({length:Math.min(REQ_MAX,batches.length)}, worker));
+    if(failed) throw failed;
+    const fin = await sb.rpc('persil_finalize', {p_layer:id});
+    if(fin.error) throw fin.error;
+    const r = fin.data;
+    if(r.count !== feats.length) toast(`⚠ ${feats.length} poligon dikirim, ${r.count} tersimpan (geometri kosong/duplikat dilewati)`, 6000);
+    addVectorOverlay({id, name, color, count:r.count, bounds:r.bounds});
+  }catch(e){
+    if(rowCreated){ try{ await sb.from('layers').delete().eq('id', id); }catch(_){} }   // cascade menghapus persil setengah jadi
+    throw new Error('Gagal menyimpan ke Supabase ('+(e.message||e)+'). Layer belum tersimpan.');
+  }finally{
+    uploadingLayer = false;
+  }
+}
