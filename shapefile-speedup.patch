+/* Laporan: cocokkan titik rumah ibadah dengan layer persil vector di database */
+async function persilCek(layers){
+  const ids = layers.map(o=>o.id), names = Object.fromEntries(layers.map(o=>[o.id,o.name]));
+  const out = new Map(), BATCH = 250, jobs = [];
+  for(let st=0; st<data.length; st+=BATCH){
+    const pts = data.slice(st, st+BATCH).map((d,k)=>({i:st+k, lng:d.lng, lat:d.lat}));
+    jobs.push(limited(()=>withRetry(async ()=>{
+      const {data:rows, error} = await sb.rpc('persil_cek', {p_layers:ids, p_pts:pts});
+      if(error) throw error;
+      rows.forEach(r=>{
+        const a = out.get(r.i) || [];
+        a.push({nib:r.nib||'', layer:names[r.layer_id]||r.layer_id,
+                p:{NIB:r.nib||'', TIPEHAK:r.tipe_hak||'', KELURAHAN:r.kelurahan||'', KECAMATAN:r.kecamatan||''}});
+        out.set(r.i, a);
+      });
+    })));
+  }
+  await Promise.all(jobs);
+  return out;
+}
