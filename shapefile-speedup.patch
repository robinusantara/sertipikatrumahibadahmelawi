+async function fetchServerLayerFc(l){
+  const ver = layerVer(l);
+  const cached = await cacheGet(l.id, ver);
+  if(cached) return cached;
+  let feats;
+  if(l.chunks > 0){
+    const parts = await Promise.all(Array.from({length:l.chunks}, (_,n)=> limited(()=> withRetry(async ()=>{
+      const {data, error} = await sb.from('layer_chunks').select('features').eq('layer_id', l.id).eq('n', n).single();
+      if(error){
+        if(error.code==='PGRST116') throw Object.assign(new Error(`potongan data #${n} tidak ada (unggahan tidak selesai)`), {fatal:true});
+        throw error;
+      }
+      return data.features;
+    }))));
+    feats = parts.flat();
+  }else{
+    const {data:rows, error} = await sb.from('layer_chunks').select('n,features').eq('layer_id', l.id).order('n');
+    if(error) throw error;
+    feats = rows.flatMap(r=>r.features);
+  }
+  if(!feats.length) throw new Error('layer kosong (unggahan tidak selesai)');
+  const fc = {type:'FeatureCollection', features:feats};
+  cachePut(l.id, ver, fc);
+  return fc;
+}
